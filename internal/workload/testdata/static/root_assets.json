{
  "image_directory": "/srv/public",
  "limits": {
    "max_bytes": 1073741824,
    "max_file_bytes": 134217728
  },
  "serving": {
    "headers": {
      "Cross-Origin-Opener-Policy": "same-origin",
      "Cross-Origin-Embedder-Policy": "require-corp",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Content-Security-Policy": "default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    },
    "header_rules": [
      {
        "paths": [
          "*.br"
        ],
        "headers": {
          "Content-Type": "application/octet-stream"
        },
        "methods": [
          "GET"
        ],
        "existing_file": true
      },
      {
        "paths": [
          "*.html",
          "/"
        ],
        "headers": {
          "Cache-Control": "no-cache, no-store, must-revalidate"
        }
      },
      {
        "paths": [
          "*.pck",
          "*.wasm",
          "*.js"
        ],
        "headers": {
          "Cache-Control": "no-cache, must-revalidate"
        },
        "except_paths": [
          "/releases/*"
        ]
      },
      {
        "paths": [
          "*.pck"
        ],
        "headers": {
          "Content-Type": "application/octet-stream"
        }
      },
      {
        "paths": [
          "*.json"
        ],
        "headers": {
          "Cache-Control": "no-cache, must-revalidate"
        },
        "except_paths": [
          "/releases/*"
        ]
      },
      {
        "paths": [
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.svg",
          "*.ico",
          "*.ttf",
          "*.woff",
          "*.woff2"
        ],
        "headers": {
          "Cache-Control": "no-cache, must-revalidate"
        },
        "except_paths": [
          "/releases/*"
        ]
      },
      {
        "path_regexp": "^/releases/[0-9a-f]{64}/[^/]+$",
        "headers": {
          "Cache-Control": "public, max-age=31536000, immutable"
        }
      }
    ],
    "precompressed": [
      "br",
      "gzip"
    ],
    "encode": [
      "gzip"
    ],
    "encode_content_types": [
      "text/*",
      "application/json*",
      "application/javascript*"
    ]
  }
}
