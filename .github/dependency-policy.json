{
  "version": 2,
  "mode": "auto",
  "ci_workflow": "ci.yml",
  "required_checks": [
    "validate / Fast source checks / Make fast",
    "Documentation policy"
  ],
  "max_group_size": 10,
  "managed_dependencies": [
    "nicodes/tools/*",
    "nicodes/cicd/*",
    "nicodes/komizo-actions/*",
    "aviorstudio/gdam-actions/*"
  ],
  "sensitive_dependencies": [
    "*argon2*",
    "*bcrypt*",
    "*clerk*",
    "*crypto*",
    "*drizzle*",
    "*jose*",
    "*jsonwebtoken*",
    "*migrate*",
    "*oauth*",
    "*openid*",
    "*passport*",
    "*pocketbase*",
    "*prisma*",
    "@noble/*",
    "github.com/go-sql-driver/mysql",
    "github.com/jackc/pgx/*",
    "github.com/nicodes/ghenv",
    "go.mongodb.org/mongo-driver/*",
    "modernc.org/sqlite"
  ],
  "request_workflow": "request-merge.yml"
}
