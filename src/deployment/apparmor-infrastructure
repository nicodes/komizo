# Fixed native ingress and DNS roles. Everything not listed is denied.
#include <tunables/global>
profile komizo-proxy flags=(attach_disconnected,mediate_deleted) {
  # Closed runtime reads: do not include distro abstractions/base.d or home
  # write rules. Host libraries are read-only; daemon entrypoints are below.
  /{usr/,}lib/** r,
  /{usr/,}lib/**.so* mr,
  /etc/ld-musl-*.path r,
  /etc/localtime r,
  /usr/share/zoneinfo/** r,
  /dev/log w,
  /dev/{random,urandom} r,
  /dev/{null,zero,full} rw,
  /proc/{meminfo,stat,cpuinfo,filesystems} r,
  /proc/sys/kernel/{version,ngroups_max,cap_last_cap} r,
  /proc/sys/vm/overcommit_memory r,
  /sys/devices/system/cpu/{online,possible} r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  ptrace (readby,tracedby) peer=unconfined,
  /usr/local/bin/caddy mrix,
  /etc/komizo-proxy/ r,
  /etc/komizo-proxy/** r,
  /var/lib/komizo-assets/ r,
  /var/lib/komizo-assets/** r,
  owner /var/lib/komizo-proxy/ rw,
  owner /var/lib/komizo-proxy/** rwk,
  owner /run/komizo-proxy/ rw,
  owner /run/komizo-proxy/** rwk,
  owner /run/openrc/supervise-komizo-proxy.sock w,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/nsswitch.conf r,
  /etc/ssl/** r,
  /usr/share/ca-certificates/ r,
  /usr/share/ca-certificates/** r,
  /proc/sys/net/core/somaxconn r,
  owner /proc/*/fd/ r,
  owner /proc/*/fd/** rw,
  owner /proc/*/{stat,status,statm,maps,mountinfo,limits,cgroup} r,
  owner /proc/*/attr/{current,apparmor/current} r,
  /sys/fs/cgroup/** r,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  capability net_bind_service,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=komizo-proxy,
  ptrace (read) peer=komizo-proxy,
  deny /var/lib/komizo/** rwklx,
  deny /etc/komizo/** rwklx,
  deny /run/komizo/** rwklx,
  deny /etc/ssh/** rwklx,
  deny /etc/{shadow,gshadow} rwklx,
  deny /root/** rwklx,
  deny /var/lib/containers/** rwklx,
  deny mount,
}
profile komizo-dns flags=(attach_disconnected,mediate_deleted) {
  # Closed runtime reads: do not include distro abstractions/base.d or home
  # write rules. Host libraries are read-only; daemon entrypoints are below.
  /{usr/,}lib/** r,
  /{usr/,}lib/**.so* mr,
  /etc/ld-musl-*.path r,
  /etc/localtime r,
  /usr/share/zoneinfo/** r,
  /dev/log w,
  /dev/{random,urandom} r,
  /dev/{null,zero,full} rw,
  /proc/{meminfo,stat,cpuinfo,filesystems} r,
  /proc/sys/kernel/{version,ngroups_max,cap_last_cap} r,
  /proc/sys/vm/overcommit_memory r,
  /sys/devices/system/cpu/{online,possible} r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  ptrace (readby,tracedby) peer=unconfined,
  /usr/libexec/podman/aardvark-dns mrix,
  owner /run/containers/networks/aardvark-dns/ rw,
  owner /run/containers/networks/aardvark-dns/** rwk,
  /etc/hosts r,
  /etc/resolv.conf r,
  /etc/nsswitch.conf r,
  owner /proc/*/{stat,status,statm,maps,limits,cgroup} r,
  owner /proc/*/attr/{current,apparmor/current} r,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix dgram,
  capability net_bind_service,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=komizo-dns,
  ptrace (read) peer=komizo-dns,
  deny /var/lib/komizo/** rwklx,
  deny /etc/komizo/** rwklx,
  deny /run/komizo/** rwklx,
  deny /etc/ssh/** rwklx,
  deny /etc/{shadow,gshadow} rwklx,
  deny /root/** rwklx,
  deny /var/lib/containers/** rwklx,
  deny /var/lib/komizo-proxy/** rwklx,
  deny mount,
}
