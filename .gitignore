# Built binaries. `go build` names its output after the directory it builds, so
# an absent -o leaves a stray `komizo` next to the source.
bin/
/komizo

# Machine-local Claude Code settings.
.claude/settings.local.json

# Release artefacts, built by mise run build. Anchored at the root:
# internal/ui/dist is a COMMITTED export (see api/build.rs), and an
# unanchored "dist/" would ignore it.
/dist/

# Compiled agents, embedded into the CLI by internal/agent. Built by
# `mise run agents` and by the release workflow -- never committed, because a
# binary in git is a binary nobody can review.
/internal/agent/bin/*
!/internal/agent/bin/.keep

# The web app's dependencies and local build state -- installed by `mise run ui`
# or CI, never committed.
/ui/node_modules/
/ui/dist/

/.artifacts/

__pycache__/

/.ci-tools/
/api/target/
/internal/nativeapi/payload.gz
